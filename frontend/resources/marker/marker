#!/bin/bash
# Marker tool wrapper script
# This script runs marker_single (for single PDF files) using the pipx installation
# IMPORTANT: This wrapper MUST use marker_single, not marker, because marker expects a directory

set -e

# Try to find marker_single in various locations
MARKER_PYTHON=""
MARKER_SCRIPT=""

# First, try to use marker_single from pipx if available (REQUIRED for single files)
if [ -f "$HOME/.local/pipx/venvs/marker-pdf/bin/marker_single" ]; then
    MARKER_PYTHON="$HOME/.local/pipx/venvs/marker-pdf/bin/python"
    MARKER_SCRIPT="$HOME/.local/pipx/venvs/marker-pdf/bin/marker_single"
    # Verify the script exists and is readable
    if [ ! -r "$MARKER_SCRIPT" ]; then
        echo "Error: marker_single script is not readable: $MARKER_SCRIPT" >&2
        exit 1
    fi
# Try system PATH for marker_single
elif command -v marker_single >/dev/null 2>&1; then
    exec marker_single "$@"
else
    # Enhanced error message with installation instructions
    echo "Error: marker-pdf is not installed." >&2
    echo "" >&2
    echo "Marker 工具需要 marker-pdf 才能运行。" >&2
    echo "" >&2
    
    # 检测是否安装了 Homebrew
    BREW_AVAILABLE=false
    if command -v brew >/dev/null 2>&1; then
        BREW_AVAILABLE=true
    fi
    
    if [ "$BREW_AVAILABLE" = false ]; then
        echo "检测到您的系统未安装 Homebrew。" >&2
        echo "" >&2
        echo "Marker 工具需要使用 Homebrew 来安装 marker-pdf。" >&2
        echo "" >&2
        echo "请先安装 Homebrew：" >&2
        echo "  1. 打开终端，运行以下命令：" >&2
        echo "     /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"" >&2
        echo "" >&2
        echo "  2. 或者访问 https://brew.sh 查看安装说明" >&2
        echo "" >&2
        echo "  3. 安装 Homebrew 后，运行以下命令安装 marker-pdf：" >&2
        echo "     brew install jpeg libpng freetype openjpeg libtiff webp" >&2
        echo "     brew install pipx" >&2
        echo "     pipx install marker-pdf" >&2
        echo "" >&2
        exit 1
    fi
    
    echo "安装方法：" >&2
    echo "" >&2
    echo "使用 Homebrew 安装 marker-pdf：" >&2
    echo "  1. 首先安装 Pillow 编译所需的依赖库：" >&2
    echo "     brew install jpeg libpng freetype openjpeg libtiff webp" >&2
    echo "" >&2
    echo "  2. 安装 pipx：" >&2
    echo "     brew install pipx" >&2
    echo "" >&2
    echo "  3. 安装 marker-pdf：" >&2
    echo "     pipx install marker-pdf" >&2
    echo "" >&2
    
    echo "验证安装：" >&2
    echo "  安装完成后，运行以下命令验证：" >&2
    echo "  pipx list  # 应该看到 marker-pdf" >&2
    echo "  marker_single --version  # 检查版本（如果可用）" >&2
    echo "" >&2
    echo "详细说明：" >&2
    echo "  marker-pdf 是一个 Python 工具，用于将 PDF 转换为 Markdown。" >&2
    echo "  它需要 Python 3.8+ 和 pipx 来安装和管理。" >&2
    echo "  pipx 是一个 Python 包管理器，用于安装独立的 Python 应用。" >&2
    echo "" >&2
    echo "如果已安装但无法找到，请检查：" >&2
    echo "  - pipx 是否在 PATH 中: which pipx" >&2
    echo "  - marker-pdf 是否正确安装: pipx list" >&2
    echo "  - 期望位置: $HOME/.local/pipx/venvs/marker-pdf/bin/marker_single" >&2
    exit 1
fi

# If we found marker_single, execute it with Python
if [ -n "$MARKER_PYTHON" ] && [ -n "$MARKER_SCRIPT" ] && [ -f "$MARKER_SCRIPT" ]; then
    # Set environment variables to force CPU usage and avoid Metal shader errors
    # This prevents crashes on macOS with Python 3.14 and PyTorch MPS backend
    # 这些设置确保在不同 macOS 机器上行为一致，避免因 GPU 支持差异导致的问题
    export PYTORCH_ENABLE_MPS_FALLBACK=1
    export PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.0
    export PYTORCH_MPS_FORCE_CPU=1
    export PYTORCH_MPS_DISABLE=1
    export CUDA_VISIBLE_DEVICES=""
    export TORCH_DEVICE=cpu
    # 禁用 Python 字节码缓存，避免版本差异问题
    export PYTHONDONTWRITEBYTECODE=1
    
    # Set model cache directories to avoid re-downloading models on each run
    # Hugging Face cache directory (使用绝对路径)
    if [ -n "$HOME" ]; then
        # Detect OS and set appropriate cache directories
        if [[ "$OSTYPE" == "darwin"* ]]; then
            # macOS - 使用绝对路径
            HF_CACHE_DIR="$(cd "$HOME/Library/Caches/huggingface" 2>/dev/null && pwd || echo "$HOME/Library/Caches/huggingface")"
            SURYA_CACHE_DIR="$(cd "$HOME/Library/Caches/datalab/models" 2>/dev/null && pwd || echo "$HOME/Library/Caches/datalab/models")"
        else
            # Linux and other Unix-like systems - 使用绝对路径
            HF_CACHE_DIR="$(cd "$HOME/.cache/huggingface" 2>/dev/null && pwd || echo "$HOME/.cache/huggingface")"
            SURYA_CACHE_DIR="$(cd "$HOME/.cache/datalab/models" 2>/dev/null && pwd || echo "$HOME/.cache/datalab/models")"
        fi
        
        # Ensure cache directories exist (创建目录，如果不存在)
        mkdir -p "$HF_CACHE_DIR" 2>/dev/null || true
        mkdir -p "$HF_CACHE_DIR/hub" 2>/dev/null || true
        mkdir -p "$SURYA_CACHE_DIR" 2>/dev/null || true
        
        # 确保路径是绝对路径（如果上面的 cd 失败，使用 readlink -f 或 realpath）
        if command -v realpath >/dev/null 2>&1; then
            HF_CACHE_DIR="$(realpath -m "$HF_CACHE_DIR" 2>/dev/null || echo "$HF_CACHE_DIR")"
            SURYA_CACHE_DIR="$(realpath -m "$SURYA_CACHE_DIR" 2>/dev/null || echo "$SURYA_CACHE_DIR")"
        elif command -v readlink >/dev/null 2>&1; then
            HF_CACHE_DIR="$(readlink -f "$HF_CACHE_DIR" 2>/dev/null || echo "$HF_CACHE_DIR")"
            SURYA_CACHE_DIR="$(readlink -f "$SURYA_CACHE_DIR" 2>/dev/null || echo "$SURYA_CACHE_DIR")"
        fi
        
        # Export environment variables
        # 这些变量确保模型缓存路径一致，避免重复下载
        # 使用绝对路径，确保 marker-pdf 能够正确识别
        export HF_HOME="$HF_CACHE_DIR"
        export HF_HUB_CACHE="$HF_CACHE_DIR"
        export HUGGINGFACE_HUB_CACHE="$HF_CACHE_DIR"
        export TRANSFORMERS_CACHE="$HF_CACHE_DIR"
        export HF_DATASETS_CACHE="$HF_CACHE_DIR"
        export HF_DATASETS_STORAGE_PATH="$HF_CACHE_DIR"
        # 添加额外的环境变量，确保 marker-pdf 能够正确识别缓存目录
        export HF_CACHE_DIR="$HF_CACHE_DIR"
        export HF_HUB_CACHE_DIR="$HF_CACHE_DIR/hub"
        export SURYA_MODEL_CACHE_DIR="$SURYA_CACHE_DIR"
    fi
    
    # Use the Python from the pipx venv to execute marker_single
    exec "$MARKER_PYTHON" "$MARKER_SCRIPT" "$@"
else
    echo "Error: Failed to execute marker_single. Python: $MARKER_PYTHON, Script: $MARKER_SCRIPT" >&2
    exit 1
fi

