#!/usr/bin/env bash

YELLOW="\e[93m"
GREEN="\e[32m"
RED="\e[31m"
ENDCOLOR="\e[0m"

printMessage() {
   printf "${YELLOW}AppFlowy : $1${ENDCOLOR}\n"
}

printSuccess() {
   printf "${GREEN}AppFlowy : $1${ENDCOLOR}\n"
}

printError() {
   printf "${RED}AppFlowy : $1${ENDCOLOR}\n"
}

printMessage "Running local AppFlowy pre-commit hook."

#flutter format .
##https://gist.github.com/benmccallum/28e4f216d9d72f5965133e6c43aaff6e
limit=$(( 1 * 2**20 )) # 1MB

function file_too_large(){
	filename=$1
	filesize=$2
	filesize_mb=$(( filesize / 2**20 ))

	cat <<HEREDOC

	File $filename is $filesize_mb MB, which is larger than github's maximum
        file size (1 MB). We will not be able to push this file to GitHub.
	Commit aborted
HEREDOC

}

empty_tree=$( git hash-object -t tree /dev/null )
if git rev-parse --verify HEAD > /dev/null 2>&1
then
	against=HEAD
else
	against=empty_tree
fi

for file in $( git diff-index --cached --name-only $against ); do
	# 检查文件是否存在
	if [ ! -f "$file" ]; then
		# 文件不存在，可能是被删除的文件，跳过检查
		continue
	fi
	
	# 排除 .githooks 目录中的大文件（如 gitlint）
	if [[ "$file" == .githooks/* ]]; then
		continue
	fi
	
	# 获取文件大小，如果失败则跳过
	file_size=$( ls -la "$file" 2>/dev/null | awk '{ print $5 }')
	
	# 检查 file_size 是否为空或不是数字
	if [ -z "$file_size" ] || ! [[ "$file_size" =~ ^[0-9]+$ ]]; then
		# 无法获取文件大小，跳过检查
		continue
	fi
	
	if [ "$file_size" -gt "$limit" ]; then
		file_too_large "$file" "$file_size"
		exit 1;
	fi
done
